# Copia este archivo como `.env` para desarrollo local y configura las mismas
# variables en el proveedor de despliegue. La clave anónima es pública por
# diseño: las políticas RLS y las funciones RPC limitan lo que puede hacer.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# No añadas aquí UUID de administradores ni la service-role key. Los primeros
# se gestionan en `food_admins`; la service-role pertenece únicamente al scraper.
# El código conserva compatibilidad con `VITE_SUPABASE_ANON_KEY` para proyectos
# que aún usen la clave anónima heredada.
